{ config, lib, ... }:

let
  cfg = config.services.containers.inventree;

  inventree = {
    # Path *inside* the nspawn container that becomes INVENTREE_EXT_VOLUME.
    # This is where the postgres cluster, media, static files and secret key all live
    # (the selected version's compose file maps ALL of it from a single bind-mounted volume).
    dataDir = "/var/lib/inventree/data";
    composeDir = "/etc/inventree-docker";

    # Where the secret files supplied via *File options are bind-mounted, read-only.
    secretsDir = "/run/inventree";
  };

  # ---------------------------------------------------------------------------
  # Version registry - auto-discovered from the per-version subdirectories.
  # ---------------------------------------------------------------------------
  # Each <tag>/ directory next to this file is one supported InvenTree release,
  # supplying its own default.nix:
  #
  #   { tag; proxy;                       # "nginx" (<= 0.13) | "caddy" (>= 0.14)
  #     dockerComposeYml;                 # verbatim upstream
  #     proxyConfig = { file; text; };    # nginx.prod.conf / Caddyfile, verbatim
  #     extraEnv ? ""; }
  #
  # alongside those verbatim files. To add a rung, drop in a new <tag>/
  # directory; nothing in this file changes.
  #
  # Two proxy topologies are handled:
  #   - "nginx"  (0.11-0.13): the stack ships an nginx proxy on :80; this module
  #     fronts it with its own Caddy for the tailnet TLS certificate.
  #   - "caddy"  (0.14 onward): the stack ships its own Caddy, which faces the
  #     tailnet directly and pulls the *.ts.net certificate from the container's
  #     tailscaled. The module's own Caddy is not used.
  # The 1.x series (a rewrite) keeps the caddy topology but renames some .env
  # vars and bumps postgres to 17 - see `isV1` below.
  versions = lib.mapAttrs
    (name: _: import (./. + "/${name}"))
    (lib.filterAttrs (_: t: t == "directory") (builtins.readDir ./.));

  selected = versions.${cfg.version};
  dockerComposeYml = selected.dockerComposeYml;

  caddyGen = selected.proxy == "caddy";
  # 1.x renamed the proxy port vars, enables redis by default, and ships
  # postgres:17. `version` is a real release string, so a numeric compare is safe.
  isV1 = lib.versionAtLeast cfg.version "1.0.0";

  # Compose override generated by the module (not upstream). Two reasons it may
  # exist: pinning the postgres image (e.g. staying on :13 while upstream ships
  # :17), and - caddy generation - mounting tailscaled's socket into the proxy
  # container so the bundled Caddy can fetch the *.ts.net certificate.
  composeOverride =
    let
      lines =
        lib.optionals (cfg.database.image != null) [
          "  inventree-db:"
          "    image: ${cfg.database.image}"
        ]
        ++ lib.optionals caddyGen [
          "  inventree-proxy:"
          "    volumes:"
          "      - /run/tailscale/tailscaled.sock:/var/run/tailscale/tailscaled.sock"
        ];
    in
    if lines == [ ] then null
    else lib.concatStringsSep "\n" ([
      "# Generated by the inventree NixOS module (not from upstream)."
      "services:"
    ] ++ lines) + "\n";

  composeFileArgs = "-f docker-compose.yml"
    + lib.optionalString (composeOverride != null) " -f docker-compose.override.yml";

  # nginx gen: the stack's proxy is published here and the module's Caddy (or the
  # user's own) reverse-proxies to it. caddy gen: the stack's Caddy is the front
  # door, so it takes :80 directly (and :443 from the upstream compose) unless
  # the user is running their own proxy in front (caddy.enable = false).
  webPort = if caddyGen && cfg.caddy.enable then 80 else cfg.port;

  # Non-secret half of upstream's docker/production/.env. The DB and SMTP
  # passwords are appended at service-start time from the bind-mounted secret
  # files - never baked into the store.
  envTemplate = pkgs: pkgs.writeText "inventree.env" (''
    INVENTREE_EXT_VOLUME=${inventree.dataDir}
    INVENTREE_DEBUG=False
    INVENTREE_LOG_LEVEL=WARNING
    INVENTREE_DB_ENGINE=postgresql
    INVENTREE_DB_NAME=${cfg.database.name}
    INVENTREE_DB_HOST=inventree-db
    INVENTREE_DB_PORT=5432
    INVENTREE_DB_USER=${cfg.database.user}
    INVENTREE_GUNICORN_TIMEOUT=30
    INVENTREE_PLUGINS_ENABLED=False
    INVENTREE_TAG=${cfg.version}
    COMPOSE_PROJECT_NAME=${cfg.composeProjectName}
  '' + lib.optionalString (!isV1) ''
    INVENTREE_WEB_PORT=${toString webPort}
  '' + lib.optionalString caddyGen ''
    INVENTREE_SITE_URL=${cfg.siteUrl}
    INVENTREE_USE_X_FORWARDED_HOST=True
    INVENTREE_USE_X_FORWARDED_PORT=True
    INVENTREE_USE_X_FORWARDED_PROTO=True
    INVENTREE_AUTO_UPDATE=False
  '' + lib.optionalString isV1 ''
    INVENTREE_WEB_PORT=8000
    INVENTREE_HTTP_PORT=${toString webPort}
    INVENTREE_HTTPS_PORT=443
    INVENTREE_CACHE_ENABLED=True
    INVENTREE_CACHE_HOST=inventree-cache
    INVENTREE_CACHE_PORT=6379
  '' + (selected.extraEnv or "") + lib.optionalString cfg.enableGoogleLogin ''
    INVENTREE_SOCIAL_BACKENDS=allauth.socialaccount.providers.google
  '' + lib.optionalString (cfg.smtp.host != "") ''
    INVENTREE_EMAIL_HOST=${cfg.smtp.host}
    INVENTREE_EMAIL_PORT=${toString cfg.smtp.port}
    INVENTREE_EMAIL_USERNAME=${cfg.smtp.username}
    INVENTREE_EMAIL_SENDER=${cfg.smtp.sender}
    INVENTREE_EMAIL_TLS=${if cfg.smtp.useTls then "True" else "False"}
    INVENTREE_EMAIL_SSL=${if cfg.smtp.useSsl then "True" else "False"}
  '');
in
{
  options.services.containers.inventree = {
    enable = lib.mkEnableOption ''
      an InvenTree instance (releases 0.11 through 1.5) running its upstream
      production docker-compose stack inside a systemd-nspawn container
    '';

    version = lib.mkOption {
      type = lib.types.enum (lib.attrNames versions);
      default = "0.17.14";
      description = ''
        Which InvenTree release to run. Two proxy generations are offered:
        0.11-0.13 (the stack ships nginx; the module fronts it with its own
        Caddy) and 0.14 onward (the stack ships its own Caddy, which faces the
        tailnet directly). 0.17.14 is the last release before the 1.0 rewrite;
        1.1.12 is the last that runs on a `postgres:13` cluster (1.2+ needs
        PostgreSQL 14+ - see
        {option}`services.containers.inventree.database.image`).

        Raising this is an in-place upgrade against the shared
        {option}`services.containers.inventree.dataDir` database - schema
        migrations run automatically on every start. Downgrades are not
        supported. Releases up to 0.17 are past upstream security support and
        must stay off the public internet; 1.x is current.
      '';
    };

    hostname = lib.mkOption {
      type = lib.types.str;
      default = "inventree";
      description = ''
        Hostname of the InvenTree container. Also used as the nspawn container
        name (hence the name of the generated `container@<name>.service`) and as
        the default {option}`services.containers.inventree.virtualHost`.
      '';
    };

    stateVersion = lib.mkOption {
      type = lib.types.str;
      default = "25.11";
      description = ''
        `system.stateVersion` for the container's own NixOS instance. Set this
        once, when the container is first created, and leave it.
      '';
    };

    virtualHost = lib.mkOption {
      type = lib.types.str;
      default = cfg.hostname;
      defaultText = lib.literalExpression "config.services.containers.inventree.hostname";
      description = ''
        Host name InvenTree is reached at. For the 0.11-0.13 generation this is
        the module Caddy's vhost; for 0.14-0.17 it is the default host part of
        {option}`services.containers.inventree.siteUrl`. Set it to the
        fully-qualified name users type (e.g. the `<hostname>.<tailnet>.ts.net`
        MagicDNS name); defaults to the bare container hostname.
      '';
    };

    siteUrl = lib.mkOption {
      type = lib.types.str;
      default = "https://${cfg.virtualHost}";
      defaultText = lib.literalExpression ''"https://" + config.services.containers.inventree.virtualHost'';
      description = ''
        `INVENTREE_SITE_URL` - the canonical externally-visible URL. Used from
        the 0.14 (Caddy) generation on: it is the bundled Caddy's site address
        (an `https://<name>.ts.net` value makes Caddy fetch the tailnet
        certificate automatically), and InvenTree derives its CSRF trusted
        origins from it - mandatory from 0.16, the server refuses to start
        without it. Ignored by the 0.11-0.13 (nginx) generation.
      '';
    };

    port = lib.mkOption {
      type = lib.types.port;
      default = 1337;
      description = ''
        Plain-HTTP port the InvenTree stack's proxy publishes on the container.
        0.11-0.13: the module's Caddy (or, with
        {option}`services.containers.inventree.caddy.enable` = false, your own
        proxy) reverse-proxies to `http://<appAddress>:<port>`. 0.14 onward: the
        bundled Caddy takes :80 and :443 directly, and this only applies when
        `caddy.enable` = false - it becomes the HTTP port (`INVENTREE_WEB_PORT`
        up to 0.17, `INVENTREE_HTTP_PORT` from 1.0).
      '';
    };

    hostAddress = lib.mkOption {
      type = lib.types.str;
      default = "192.168.100.2";
      description = ''
        IPv4 address of the host side of the container's private veth link (the
        outer machine's end of the point-to-point pair).
      '';
    };

    appAddress = lib.mkOption {
      type = lib.types.str;
      default = "192.168.100.3";
      description = ''
        IPv4 address assigned to the InvenTree container on its private veth link
        (the container's own end of the point-to-point pair).
      '';
    };

    dataDir = lib.mkOption {
      type = lib.types.str;
      default = "/srv/inventree/data";
      description = ''
        Host directory holding InvenTree's single external volume: the postgres
        cluster, media, static files and Django secret key. Bind-mounted into the
        container. Switching {option}`services.containers.inventree.version` migrates this
        database in place, so keep it stable across upgrades.
      '';
    };

    dockerDir = lib.mkOption {
      type = lib.types.str;
      default = "/srv/inventree/docker";
      description = ''
        Host directory backing the container's own `/var/lib/docker`, kept
        separate from {option}`services.containers.inventree.dataDir` so images and layers
        can be discarded without touching the database.
      '';
    };

    composeProjectName = lib.mkOption {
      type = lib.types.str;
      default = cfg.hostname;
      defaultText = lib.literalExpression "config.services.containers.inventree.hostname";
      description = ''
        `COMPOSE_PROJECT_NAME` for the stack. Only a label - but it names the
        docker resources, so changing it on a running instance orphans the old
        containers. Pin it if you rename the host.
      '';
    };

    enableGoogleLogin = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = ''
        Load django-allauth's Google provider. The OAuth client ID/secret are
        *not* configured here - they live in the database as a SocialApp row
        (Django Admin -> Sites -> Social Applications), which comes along with any
        database restore from an instance that already had Google login set up.
        This flag only controls whether InvenTree loads the provider app at all.
      '';
    };

    database = {
      name = lib.mkOption {
        type = lib.types.str;
        default = "inventree";
        description = "PostgreSQL database name (`INVENTREE_DB_NAME`).";
      };
      user = lib.mkOption {
        type = lib.types.str;
        default = "inventree";
        description = ''
          PostgreSQL role the stack connects as (`INVENTREE_DB_USER`). The
          bundled postgres container creates this role on first run; for an
          existing database it must match the role that already owns it.
        '';
      };
      passwordFile = lib.mkOption {
        type = lib.types.nullOr lib.types.path;
        default = null;
        description = ''
          Host path to a file containing the PostgreSQL password. Bind-mounted
          read-only into the container and read at service start - never copied
          into the store. Required when the module is enabled. Wire this to
          agenix/sops/etc. yourself; make sure the file exists before
          `container@${cfg.hostname}.service` starts.
        '';
      };
      image = lib.mkOption {
        type = lib.types.nullOr lib.types.str;
        default = null;
        example = "postgres:13";
        description = ''
          Override the PostgreSQL container image. `null` uses whatever the
          selected version's compose file ships: `postgres:13` for 0.11-0.17,
          `postgres:17` for 1.0+.

          Postgres major versions store their on-disk data incompatibly, so this
          cannot simply jump: the 0.11-0.17 line runs on `postgres:13`, and
          1.0.x / 1.1.x still run against a 13 cluster if you pin
          `"postgres:13"` here. Moving to `postgres:17` (required by InvenTree
          1.2+) means a dump/restore into a fresh cluster - do that while on
          1.1.x following <https://inventree.org/blog/2026/02/12/db-update>, then
          set this back to `null`.
        '';
      };
    };

    tailscale = {
      enable = lib.mkOption {
        type = lib.types.bool;
        default = true;
        description = ''
          Run Tailscale inside the container. This is the module's intended
          exposure model: the InvenTree UI is reached over the tailnet and the
          bundled Caddy obtains its TLS certificate with `tailscale cert`. Turn
          this off only if you are fronting the container with your own
          networking, in which case also set
          {option}`services.containers.inventree.caddy.enable` to false.
        '';
      };
      authKeyFile = lib.mkOption {
        type = lib.types.nullOr lib.types.path;
        default = null;
        description = ''
          Host path to a file containing a Tailscale auth key, used to bring the
          container onto the tailnet non-interactively. Bind-mounted read-only.
          When null, run `tailscale up` inside the container by hand once.
        '';
      };
    };

    caddy.enable = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = ''
        Let the module terminate HTTPS for the tailnet itself. For the 0.11-0.13
        generation this runs a NixOS `services.caddy` in the container in front
        of the stack's nginx; for 0.14-0.17 the stack already ships Caddy, so
        this just means the bundled Caddy serves
        {option}`services.containers.inventree.siteUrl` on :443 with a
        Tailscale-issued certificate. Requires
        {option}`services.containers.inventree.tailscale.enable`. Disable to put
        your own reverse proxy in front (pointing at `http://<appAddress>:<port>`).
      '';
    };

    smtp = lib.mkOption {
      description = ''
        Outbound mail (password resets, notifications) via SMTP. Leave `host`
        blank to disable email entirely.
      '';
      default = { };
      type = lib.types.submodule {
        options = {
          host = lib.mkOption {
            type = lib.types.str;
            default = "";
            description = "SMTP host. Blank disables outbound email.";
          };
          port = lib.mkOption {
            type = lib.types.port;
            default = 587;
            description = "SMTP port.";
          };
          username = lib.mkOption {
            type = lib.types.str;
            default = "";
            description = "SMTP auth username.";
          };
          sender = lib.mkOption {
            type = lib.types.str;
            default = "";
            description = "From: address for outbound mail.";
          };
          useTls = lib.mkOption {
            type = lib.types.bool;
            default = true;
            description = "Use STARTTLS.";
          };
          useSsl = lib.mkOption {
            type = lib.types.bool;
            default = false;
            description = "Use implicit TLS/SSL (mutually exclusive with useTls).";
          };
          passwordFile = lib.mkOption {
            type = lib.types.nullOr lib.types.path;
            default = null;
            description = ''
              Host path to a file containing the SMTP password. Bind-mounted
              read-only into the container. Required when `host` is set.
            '';
          };
        };
      };
    };
  };

  config = lib.mkIf cfg.enable {
    assertions = [
      {
        assertion = cfg.database.passwordFile != null;
        message = "services.containers.inventree.database.passwordFile must be set when services.containers.inventree.enable is true.";
      }
      {
        assertion = cfg.smtp.host != "" -> cfg.smtp.passwordFile != null;
        message = "services.containers.inventree.smtp.passwordFile must be set when services.containers.inventree.smtp.host is non-empty.";
      }
      {
        assertion = !(cfg.smtp.useTls && cfg.smtp.useSsl);
        message = "services.containers.inventree.smtp: useTls and useSsl are mutually exclusive.";
      }
      {
        assertion = cfg.caddy.enable -> cfg.tailscale.enable;
        message = "services.containers.inventree.caddy.enable requires services.containers.inventree.tailscale.enable (the module serves virtualHost with a Tailscale certificate). Disable caddy to front the container with your own proxy.";
      }
      {
        assertion = (caddyGen && cfg.caddy.enable) -> cfg.tailscale.enable;
        message = "InvenTree ${cfg.version}: the stack's bundled Caddy serves services.containers.inventree.siteUrl and fetches its certificate from the container's tailscaled, so services.containers.inventree.tailscale.enable must be true (or set caddy.enable = false and terminate TLS at your own proxy).";
      }
      {
        assertion = !(lib.versionAtLeast cfg.version "1.2.0"
          && cfg.database.image != null
          && lib.hasInfix ":13" cfg.database.image);
        message = "InvenTree ${cfg.version} (Django 5.2) requires PostgreSQL 14+, but services.containers.inventree.database.image is pinned to a 13 image. Migrate the cluster first - https://inventree.org/blog/2026/02/12/db-update - then set database.image to \"postgres:17\" (or null). 1.1.12 is the last version that runs on postgres:13.";
      }
    ];

    systemd.tmpfiles.rules = [
      # Wide open: the postgres/inventree images use their own internal UIDs which don't map
      # to anything on the host, and it isn't worth chasing exact numbers here.
      # Tighten later if it bothers you.
      "d ${cfg.dataDir} 0777 root root -"
      "d ${cfg.dockerDir} 0711 root root -"
    ];

    containers.${cfg.hostname} = {
      privateNetwork = true;
      hostAddress = cfg.hostAddress;
      localAddress = cfg.appAddress;
      ephemeral = false;
      autoStart = true;
      enableTun = true;

      # The outer container@<name>.service only reports "active" once the inner systemd
      # reaches multi-user.target, which waits on inventree-compose's preStart (first-run
      # `invoke migrate`/`invoke static` can take several minutes). The default 1min timeout
      # kills and restarts the whole container mid-migration, forever - give it real headroom.
      timeoutStartSec = "15min";

      # Docker needs more from the container than nspawn grants by default: it wants to manage
      # its own cgroups/netns/overlayfs, which conflicts with nspawn's own user-namespace
      # remapping if that's left on, and needs capabilities nspawn's default profile omits.
      privateUsers = "no";
      additionalCapabilities = [
        "CAP_SYS_ADMIN"
        "CAP_NET_ADMIN"
        "CAP_MKNOD"
        "CAP_AUDIT_WRITE"
        "CAP_SYS_RESOURCE"
        "CAP_NET_RAW"
      ];
      # nspawn's default seccomp filter blocks bpf(2), which runc needs to attach the
      # cgroup-device BPF program when starting a container. Without this, dockerd fails
      # every container start with "bpf_prog_query(BPF_CGROUP_DEVICE) failed: operation
      # not permitted", even though CAP_SYS_ADMIN is already granted above.
      extraFlags = [ "--system-call-filter=bpf" ];

      bindMounts = {
        ${inventree.dataDir} = {
          isReadOnly = false;
          hostPath = cfg.dataDir;
        };
        # Give Docker's own storage a persistent home separate from the InvenTree data volume,
        # so you can blow away images/layers without touching the database.
        "/var/lib/docker" = {
          isReadOnly = false;
          hostPath = cfg.dockerDir;
        };
        "${inventree.secretsDir}/db-password" = {
          isReadOnly = true;
          hostPath = toString cfg.database.passwordFile;
        };
      }
      // lib.optionalAttrs (cfg.smtp.passwordFile != null) {
        "${inventree.secretsDir}/smtp-password" = {
          isReadOnly = true;
          hostPath = toString cfg.smtp.passwordFile;
        };
      }
      // lib.optionalAttrs (cfg.tailscale.authKeyFile != null) {
        "${inventree.secretsDir}/ts-authkey" = {
          isReadOnly = true;
          hostPath = toString cfg.tailscale.authKeyFile;
        };
      };

      config = { config, pkgs, lib, ... }: {
        system.stateVersion = cfg.stateVersion;

        networking = {
          hostName = cfg.hostname;
          # This relies on the private container bridge not being reachable off-box, and -
          # with the default tailscale.enable - on the instance only being published to the
          # tailnet. The module's whole reason to exist is running InvenTree releases that
          # are past upstream security support, so keep it off the public internet. If you
          # set tailscale.enable = false, it is on you to restrict who can reach
          # ${cfg.appAddress} on the host.
          firewall.enable = false;
          useHostResolvConf = lib.mkForce false;
        };

        services.resolved.enable = true;

        services.tailscale = lib.mkIf cfg.tailscale.enable {
          enable = true;
          authKeyFile = lib.mkIf (cfg.tailscale.authKeyFile != null)
            "${inventree.secretsDir}/ts-authkey";
          disableTaildrop = true;
          # nginx gen: the NixOS `caddy` user calls `tailscale cert`.
          # caddy gen: the bundled Caddy (root, in the docker proxy container)
          # fetches the cert over the daemon socket.
          permitCertUid =
            if caddyGen then "root"
            else lib.mkIf cfg.caddy.enable "caddy";
        };

        virtualisation.docker = {
          enable = true;
          # If this errors on your kernel/host fs combination, fall back to "vfs" (slower,
          # but always works nested inside another filesystem).
          storageDriver = "overlay2";
        };

        environment.etc = {
          "inventree-docker/docker-compose.yml".text = dockerComposeYml;
          "inventree-docker/${selected.proxyConfig.file}".text = selected.proxyConfig.text;
        } // lib.optionalAttrs (composeOverride != null) {
          "inventree-docker/docker-compose.override.yml".text = composeOverride;
        };

        systemd.services.inventree-compose = {
          description = "InvenTree ${cfg.version} docker-compose stack";
          after = [ "docker.service" "network-online.target" ];
          wants = [ "docker.service" "network-online.target" ];
          requires = [ "docker.service" ];
          wantedBy = [ "multi-user.target" ];

          path = [ pkgs.docker-compose pkgs.docker ];

          # Render the real .env next to the (nix-managed, read-only) compose file. It's a
          # plain file outside the store, mode 600, recreated fresh on every start.
          #
          # InvenTree's docker image does *not* run migrations on its own - docker/init.sh
          # (the image ENTRYPOINT) only creates directories/config and then execs straight into
          # gunicorn. Upstream's docs call for a one-time `invoke update` before the stack can
          # serve anything; we run its `migrate` and `static` subtasks directly (idempotent -
          # safe on every start) rather than `update` itself, since `update` also runs `invoke
          # install` (`pip install -U -r requirements.txt` against live PyPI on every boot -
          # slow, and risks drifting package versions on a tag we deliberately pinned).
          # We wait for postgres to actually accept connections first, since `depends_on` only
          # waits for the container to start, not for it to be ready.
          preStart = ''
            set -o errexit
            install -m 600 ${envTemplate pkgs} ${inventree.composeDir}/.env
            echo "INVENTREE_DB_PASSWORD=$(cat ${inventree.secretsDir}/db-password)" \
              >> ${inventree.composeDir}/.env
          '' + lib.optionalString (cfg.smtp.host != "") ''
            echo "INVENTREE_EMAIL_PASSWORD=$(cat ${inventree.secretsDir}/smtp-password)" \
              >> ${inventree.composeDir}/.env
          '' + ''

            # A version switch renames the containers (0.13+ dropped the fixed
            # container_name:), so the previous stack can still be up against the
            # same data volume. Tear down whatever is running before starting the
            # selected version - all persistent state is in the bind-mounted data
            # dir, not the containers.
            docker-compose ${composeFileArgs} down --remove-orphans || true
            docker rm -f inventree-db inventree-cache inventree-server inventree-worker inventree-proxy 2>/dev/null || true

            docker-compose ${composeFileArgs} up -d inventree-db
            docker-compose ${composeFileArgs} run --rm inventree-server invoke wait
            docker-compose ${composeFileArgs} run --rm inventree-server invoke migrate
            docker-compose ${composeFileArgs} run --rm inventree-server invoke static
          '';

          serviceConfig = {
            Type = "simple";
            WorkingDirectory = inventree.composeDir;
            ExecStart = "${pkgs.docker-compose}/bin/docker-compose ${composeFileArgs} up --remove-orphans";
            ExecStop = "${pkgs.docker-compose}/bin/docker-compose ${composeFileArgs} down";
            ExecStopPost = "${pkgs.coreutils}/bin/shred -u ${inventree.composeDir}/.env";
            Restart = "on-failure";
            RestartSec = 10;
            # First-run migrations (full schema + rebuild_models/rebuild_thumbnails +
            # collectstatic) can comfortably outrun systemd's 90s default.
            TimeoutStartSec = 1200;
          };
        };

        # nginx generation only: the stack has no TLS front, so the module runs
        # its own Caddy for the tailnet certificate. The caddy generation's stack
        # already ships Caddy (it serves siteUrl itself).
        services.caddy = lib.mkIf (cfg.caddy.enable && !caddyGen) {
          enable = true;
          virtualHosts.${cfg.virtualHost} = {
            extraConfig = ''
              reverse_proxy http://localhost:${toString cfg.port}
            '';
          };
        };

        environment.systemPackages =
          lib.optional cfg.tailscale.enable pkgs.tailscale
          ++ [ pkgs.docker-compose ];
      };
    };
  };
}
